# cimd-proxy — environment template.
#
# Copy to deploy.env, fill in real values, and feed it to the container with
# `docker compose --env-file deploy.env` or `docker run --env-file deploy.env`.
# Every required value is checked at start: a missing one is a loud error, and
# a set RESOURCE_n index above a gap is likewise a loud error rather than a
# silently shortened table.
#
# Never commit a filled copy of this file.

# ---------------------------------------------------------------------------
# Proxy identity and secret
# ---------------------------------------------------------------------------

# The public origin under which clients reach this proxy. It is published as
# the issuer in the discovery document, so it has to match what the client
# actually calls, scheme included.
PROXY_PUBLIC_URL=https://auth.example.com

# Symmetric key for the envelopes the proxy hands out. Generate a fresh one
# per deployment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it invalidates every refresh token already issued; clients then
# re-authorize.
PROXY_SECRET_KEY=REPLACE_ME_WITH_A_FRESH_KEY

PROXY_PORT=8080
PROXY_BIND_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Adds diagnostic detail about metadata document handling. Off in production.
CIMD_DEBUG=false

# ---------------------------------------------------------------------------
# Client identity policy
# ---------------------------------------------------------------------------
#
# The proxy accepts any well-formed CIMD document URL and any RFC 8252 §7.3
# compliant redirect_uri. There is no host allowlist: an anonymous DCR
# endpoint cannot know in advance which client will register, so a check
# that would always pass would only be a false gate. Meaningful mitigations
# for untargeted registration live in the identity provider's consent step
# and in a registration rate limit — both outside this proxy.
#
# Bounds for how long a fetched document is cached, in seconds. The document's
# own cache directive is honoured within these bounds.
CIMD_CACHE_TTL_MIN=300
CIMD_CACHE_TTL_MAX=86400

# Hard cap on the document body, in bytes, enforced while reading rather than
# after.
CIMD_MAX_BYTES=5120

# Timeout for the document fetch, in seconds.
CIMD_FETCH_TIMEOUT=5

# ---------------------------------------------------------------------------
# Scope surface
# ---------------------------------------------------------------------------

# Published in the discovery document under `scopes_supported`. An empty value
# omits the field entirely — an empty array would announce that no scope is
# supported at all, which is a different statement.
#PROXY_SCOPES_SUPPORTED=openid offline_access

# Used when a client reaches /authorize without a `scope` parameter. The proxy
# fills silence only: a client that does send `scope` is neither overridden nor
# appended to.
#PROXY_DEFAULT_SCOPE=openid offline_access

# ---------------------------------------------------------------------------
# Default resource
# ---------------------------------------------------------------------------

# Used when a client sends no `resource` parameter. Empty means clients must
# send one, which is the safer production setting: with several resources
# behind one proxy, a default silently decides which audience a token is for.
# If set, the value must appear in the table below.
DEFAULT_RESOURCE=

# ---------------------------------------------------------------------------
# Resource table — indexed, contiguous from 0, no gaps
# ---------------------------------------------------------------------------
#
# One row per protected resource. Each row names the resource identifier as
# clients ask for it (RFC 8707), the upstream issuer that authenticates for it,
# and the upstream client the proxy uses on its behalf. That upstream client
# needs an audience mapper producing a token the resource server accepts.
#
# ISSUER is per row on purpose: a resource authenticated by a different realm
# or a different provider is then one more row, not a structural change.
#
# CLIENT_SECRET may be empty for a public upstream client.
#
# The URL must match, character for character, the `resource` value the
# protected resource publishes in its RFC 9728 metadata and the value the
# client sends — path included. Only the root-path trailing slash is folded
# (RFC 3986 section 6.2.3); nothing else is normalised, so a bare origin here
# against a /mcp identifier there is a refusal. See deploy/caddy/example.caddy.

RESOURCE_0_URL=https://mcp.example.com/mcp
RESOURCE_0_ISSUER=https://idp.example.com/realms/example
RESOURCE_0_CLIENT_ID=mcp-upstream-client
RESOURCE_0_CLIENT_SECRET=

# A second resource behind the same proxy:
#RESOURCE_1_URL=https://other.example.com/mcp
#RESOURCE_1_ISSUER=https://idp.example.com/realms/example
#RESOURCE_1_CLIENT_ID=other-upstream-client
#RESOURCE_1_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Personal access tokens — optional, off unless PAT_DATABASE_URL is set
# ---------------------------------------------------------------------------
#
# Without PAT_DATABASE_URL none of the keys below may be set: the feature is
# either fully configured or off. With it, every value marked required is
# checked at start. See deploy/README.md for what the identity provider and
# the database need.

# Runtime connection, as the application role (read, insert, set last use and
# revocation — nothing else). Required.
#PAT_DATABASE_URL=postgresql://cimd_proxy_app:REPLACE_ME@db.example.com:5432/app
#PAT_DATABASE_SCHEMA=cimd_proxy

# Only for `python -m cimd_proxy migrate`: the schema-owning role, and the
# application role the migrations grant to.
#PAT_MIGRATION_DATABASE_URL=postgresql://cimd_proxy_migrator:REPLACE_ME@db.example.com:5432/app
#PAT_DATABASE_APP_ROLE=cimd_proxy_app

# The realm personal access tokens live in. Every resource that accepts them
# must have this issuer. Required.
#PAT_REALM_ISSUER=https://idp.example.com/realms/example

# Alias of the identity provider of type "JWT Authorization Grant" that trusts
# this proxy. Required.
#PAT_IDP_ALIAS=cimd-proxy-pat

# Confidential client with a service account holding realm-management /
# manage-users (to link an owner to the identity provider) and the attribute
# allow.token.introspection.without.audience.check=true (to introspect the
# owner's token). Required.
#PAT_ADMIN_CLIENT_ID=cimd-proxy-admin
#PAT_ADMIN_CLIENT_SECRET=REPLACE_ME

# The client scopes a permission set may be built from, whitespace-separated.
# Required.
#PAT_SCOPES=agent-read agent-dispatch

# Signing keys for the assertions: an indexed table, contiguous from 0. Each
# FILE is an unencrypted PEM RSA private key of at least 2048 bits, mounted
# into the container — never stored in the database. Every key is published at
# /pat/jwks.json; PAT_SIGNING_KID names the one that signs. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out pat-2026-10.pem
#PAT_SIGNING_KEY_0_KID=pat-2026-10
#PAT_SIGNING_KEY_0_FILE=/run/secrets/pat-2026-10.pem
#PAT_SIGNING_KID=pat-2026-10

# The `iss` of the assertions, and the issuer configured at the identity
# provider. Defaults to PROXY_PUBLIC_URL.
#PAT_ASSERTION_ISSUER=

# Per resource that accepts personal access tokens: the confidential upstream
# client the exchange uses. The JWT Authorization Grant refuses public clients,
# so this is a separate client when the resource's interactive client is public.
#RESOURCE_0_PAT_CLIENT_ID=mcp-upstream-pat
#RESOURCE_0_PAT_CLIENT_SECRET=REPLACE_ME
